# XingClaw 环境变量模板（Windows PowerShell）
# 首次运行 run_cli.bat 会自动复制为 .env.ps1；请填入真实值。
# .env.ps1 不应提交到 Git。

# 飞书应用凭据
$env:FEISHU_APP_ID       = "cli_xxxxxxxxxxxx"
$env:FEISHU_APP_SECRET   = "your_app_secret_here"
$env:FEISHU_VERIFY_TOKEN = ""  # 可选

# LLM API Key：二选一即可，provider/model-id 必须对应。
# Anthropic 官方或智谱 GLM（glm-4.7）使用这一项：
$env:ANTHROPIC_API_KEY   = "your_anthropic_or_zhipu_api_key_here"
# OpenAI 或 DeepSeek 使用这一项：
$env:OPENAI_API_KEY      = ""  # 可选

# 模型配置（可选，覆盖默认值）
$env:XINGCLAW_PROVIDER   = "anthropic"       # anthropic / openai-standard
$env:XINGCLAW_MODEL_ID   = "glm-4.7"         # claude-sonnet-4-5 / glm-4.7 / gpt-4o-mini / deepseek-v4-pro
