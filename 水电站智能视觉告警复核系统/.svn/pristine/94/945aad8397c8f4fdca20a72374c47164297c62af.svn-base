def fire_detect(img64):
    resp = requests.post('http://192.168.1.65:7002/detect-info', json={"conf": 0.3, 'image':img64})
    # print(resp.text)
    return [e for e in resp.json()['results'] if e['class_name'] == 'Fire' or e['class_name'] == 'Smoke']

