# 抛洒物事件处理
async def debris_handler(*args, **kwargs):
    name = kwargs.get('name')
    result = kwargs.get('result')
    if result is None:
        logger.warning('result is None')
        return
    frame = kwargs.get('frame')
    if frame is None:
        logger.warning('frame is None')
        return

    # 查找外切矩形
    debris_objects = result.GetObjects('debris')
    if not debris_objects:
        return
    
    # 收集所有识别框，计算最大边界
    all_xmin, all_ymin = float('inf'), float('inf')
    all_xmax, all_ymax = float('-inf'), float('-inf')
    
    for obj in debris_objects:
        xmin, ymin, xmax, ymax = obj.rectangle()
        all_xmin = min(all_xmin, xmin)
        all_ymin = min(all_ymin, ymin)
        all_xmax = max(all_xmax, xmax)
        all_ymax = max(all_ymax, ymax)
    
    # 计算所有框的外接矩形的中心和尺寸
    center = [all_xmin + (all_xmax - all_xmin) / 2, all_ymin + (all_ymax - all_ymin) / 2]
    w, h = all_xmax - all_xmin, all_ymax - all_ymin
    area = w * h
    print(f"合并后的区域面积: {area}")
    
    # 按比例扩展，使目标在裁剪图像中占合适比例（约25%）
    target_ratio = 0.25
    expand_factor = 1.0 / target_ratio  # 扩展因子为4.0
    
    # 计算扩展后的宽高
    w_expanded = w * expand_factor
    h_expanded = h * expand_factor
    
    # 保持宽高比，取较大值确保目标完整显示
    max_dim = max(w_expanded, h_expanded)
    w, h = max_dim, max_dim
    
    # 设置最小裁剪尺寸，避免裁剪区域过小
    w, h = max(w, 0.15), max(h, 0.15)
    # 设置最大裁剪尺寸，避免超出图像范围
    w, h = min(w, 1.0), min(h, 1.0)
    
    # 只调用一次大模型
    found = {
        '抛洒物': False,
    }
    
    sess = Session(version=version, port=port, prefix=prefix)
    v = await sess.Text('照片中有什么', frame.crop64(center=center, dim=[w, h]))
    
    # cv2.imwrite(f'debug/{v}{uuid.uuid4()}.jpg', frame.crop(center=center, dim=[w, h]))
    logger.info(f"抛洒物检测: {name}:\n{v}")
    
    if '箱子' in v or '纸箱' in v or '盒子' in v or '垃圾' in v:
        found['抛洒物'] = True
        # cv2.imwrite(f'debug/抛撒物{uuid.uuid4()}.jpg', frame.crop(center=center, dim=[w, h]))
    
    return found

# 摩托车事件处理
async def motor_handler(*args, **kwargs):
    result = kwargs.get('result')
    if result is None:
        logger.warning('result is None')
        return {'摩托车':False}
    frame = kwargs.get('frame')
    if frame is None:
        logger.warning('frame is None')
        return {'摩托车':False}

    found = {'摩托车':False}
    for motor in result.GetObjects('motorcycle'):
        # print(f"Object details - Label: {motor.label()}, Center: {motor.center()}, Rectangle: {motor.rectangle()}")
        sess = Session(version=version, port=port, prefix=prefix)
        img64 = frame.crop64(motor.rectangle(), extend=0.2, resize=(512,512))
        v = await sess.Text('描述一下图片中的车辆类型', img64)
        logger.info(f"摩托车检测: {v}")
        if '摩托车' in v or '电动车' in v or '两轮车' in v or '三轮车' in v:
            found['摩托车'] = True
            return found

    return found

# 摩托车多标签处理
async def motor_label_handler(*args, **kwargs):
    result = kwargs.get('result')
    if result is None:
        logger.warning('result is None')
        return {'摩托车':False}
    frame = kwargs.get('frame')
    if frame is None:
        logger.warning('frame is None')
        return {'摩托车':False}

    # 获取env来获取配置的URL
    env = kwargs.get('env')
    token_url = env.get_token_url() if env else None
    label_url = env.get_label_url() if env else None

    found = {'摩托车':False}
    for motor in result.GetObjects('motorcycle'):
        img64 = frame.crop64(motor.rectangle(),extend=0.2)
        # img = frame.crop(motor.rectangle(),extend=0.2)
        # cv2.imwrite(f'debug/{uuid.uuid4()}.jpg', img)
        cls_token = get_cls_token(img64=img64, token_url=token_url)
        probs = get_probs(cls_token, label_url=label_url)
        if len(probs) > 4 and probs[4] > 0.95:
            found['摩托车'] = True
            return found

    return found

# 多标签模型过滤
async def person_label_handler(*args, **kwargs):
    name = kwargs.get('name')
    result = kwargs.get('result')
    if result is None:
        logger.warning('result is None')
        return {'行人':False, '施工人员':False}
    frame = kwargs.get('frame')
    if frame is None:
        logger.warning('frame is None')
        return {'行人':False, '施工人员':False}

    # 获取env来获取配置的URL
    env = kwargs.get('env')
    token_url = env.get_token_url() if env else None
    label_url = env.get_label_url() if env else None

    found = {'行人':False, '施工人员':False}
    for person in result.GetObjects('person'):
        img64 = frame.crop64(person.rectangle(),extend=0.2)
        cls_token = get_cls_token(img64=img64, token_url=token_url)
        probs = get_probs(cls_token, label_url=label_url)
        # print(name, probs)
        if probs[0] > 0.95 and probs[0] > probs[1]:
            found['行人'] = True
        if probs[1] > 0.95 and probs[1] > probs[0]:
            found['施工人员'] = True
        if found['行人'] and found['施工人员']:
            return found

    return found

async def test_person():
    frame = None
    with open('person.jpg', 'rb') as f:
        frame = Frame(data=f.read())
    result = Result()
    w,h = 1622,911
    x1,y1,x2,y2 = 441,416,616,721
    result.AddObject(Object(label='person', xmin=x1/w,ymin=y1/h,xmax=x2/w,ymax=y2/h))
    await person_handler(frame=frame, result=result)

async def test_fire():
    frame = None
    with open('fire.png', 'rb') as f:
        frame = Frame(data=f.read())
    result = Result()
    w,h = 1917,899
    x1,y1 = 611,440
    result.AddObject(Object(label='停车', center=(x1/w,y1/h)))
    await fire_handler(frame=frame, result=result)

if __name__ == '__main__':
    asyncio.run(test_fire())
