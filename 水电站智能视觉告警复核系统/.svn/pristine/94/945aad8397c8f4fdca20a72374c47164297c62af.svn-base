    pass

# 烟火事件处理
async def fire_handler(*args, **kwargs):
    name = kwargs.get('name')
    result = kwargs.get('result')
    if result is None:
        logger.warning('result is None')
        return
    frame = kwargs.get('frame')
    if frame is None:
        logger.warning('frame is None')
        return

    # 查找外切矩形
    x1,y1,x2,y2 = 1.0,1.0,0.,0.
    for obj in result.GetObjects('fire'):
        xmin,ymin,xmax,ymax = obj.rectangle()
        x1,y1,x2,y2 = min(xmin,x1),min(ymin,y1),max(xmax,x2),max(ymax,y2)

    # 以外切矩形的中心为中心，宽高至少因为原图宽高的1/2
    w,h = x2-x1,y2-y1
    center = x1+w/2,y1+h/2
    w,h = max(w,0.5),max(h,0.5)
    # w = 1. if w>1. else w
    # h = 1. if h>1. else h

    found = {'烟火':False}
    # img = frame.crop(center=center,dim=[w,h])
    # gray = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)
    # fm = cv2.Laplacian(gray, cv2.CV_64F).var()
    # if fm < 500. :
    #     logger.info(f"烟火检测: {name} - {fm},画面模糊无法判断。")
    #     return found
    
    # cv2.imwrite(f'debug/{uuid.uuid4()}.jpg', frame.crop(center=center,dim=[w,h]))
    sess = Session(version=version, port=port, prefix=prefix)
    v = await sess.Text('请描述这幅交通监控图片中的路面和车辆情况', frame.crop64(center=center,dim=[w,h]))
    # v = await sess.Text('请描述一下这幅图片中的路面和车辆的情况', frame.crop64(center=center,dim=[w,h]))
    logger.info(f"烟火检测: {name}:\n{v}")
    if '浓烟' in v or '黑烟' in v or '火焰' in v or '火光' in v or '火堆' in v or '燃烧' in v or '火苗' in v or '烟雾' in v:
        found['烟火'] = True
        # cv2.imwrite(f'debug/烟火{uuid.uuid4()}.jpg', frame.crop(center=center,dim=[w,h]))

    # if '箱子' in v or '纸箱' in v or '盒子' in v or '垃圾' in v:
    #     found['抛洒物'] = True
    #     cv2.imwrite(f'debug/抛撒物{uuid.uuid4()}.jpg', frame.crop(center=center,dim=[w,h]))

    # img = frame.crop(center=center, dim=[w,h])
    # fname = uuid.uuid4()
    # cv2.imwrite(f'debug/{fname}.jpg', img)

    # with open('desc.txt', 'a') as f:
    #     f.write(f'{name} - {fname}: {v}\n')
    #     f.flush()
    
    return found

