async def test_person():
    frame = None
    with open('person.jpg', 'rb') as f:
        frame = Frame(data=f.read())
    result = Result()
    w,h = 1622,911
    x1,y1,x2,y2 = 441,416,616,721
    result.AddObject(Object(label='person', xmin=x1/w,ymin=y1/h,xmax=x2/w,ymax=y2/h))
    await person_handler(frame=frame, result=result)

async def test_fire():
    frame = None
    with open('fire.png', 'rb') as f:
        frame = Frame(data=f.read())
    result = Result()
    w,h = 1917,899
    x1,y1 = 611,440
    result.AddObject(Object(label='停车', center=(x1/w,y1/h)))
    await fire_handler(frame=frame, result=result)

if __name__ == '__main__':
    asyncio.run(test_fire())
