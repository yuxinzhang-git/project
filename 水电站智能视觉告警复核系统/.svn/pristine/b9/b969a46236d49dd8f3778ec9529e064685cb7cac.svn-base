# 摩托车事件处理
async def motor_handler(*args, **kwargs):
    result = kwargs.get('result')
    if result is None:
        logger.warning('result is None')
        return {'摩托车':False}
    frame = kwargs.get('frame')
    if frame is None:
        logger.warning('frame is None')
        return {'摩托车':False}

    found = {'摩托车':False}
    for motor in result.GetObjects('motorcycle'):
        # print(f"Object details - Label: {motor.label()}, Center: {motor.center()}, Rectangle: {motor.rectangle()}")
        sess = Session(version=version, port=port, prefix=prefix)
        img64 = frame.crop64(motor.rectangle(), extend=0.2, resize=(512,512))
        v = await sess.Text('描述一下图片中的车辆类型', img64)
        logger.info(f"摩托车检测: {v}")
        if '摩托车' in v or '电动车' in v or '两轮车' in v or '三轮车' in v:
            found['摩托车'] = True
            return found

    return found

# 摩托车多标签处理
async def motor_label_handler(*args, **kwargs):
    result = kwargs.get('result')
    if result is None:
        logger.warning('result is None')
        return {'摩托车':False}
    frame = kwargs.get('frame')
    if frame is None:
        logger.warning('frame is None')
        return {'摩托车':False}

    # 获取env来获取配置的URL
    env = kwargs.get('env')
    token_url = env.get_token_url() if env else None
    label_url = env.get_label_url() if env else None

    found = {'摩托车':False}
    for motor in result.GetObjects('motorcycle'):
        img64 = frame.crop64(motor.rectangle(),extend=0.2)
        # img = frame.crop(motor.rectangle(),extend=0.2)
        # cv2.imwrite(f'debug/{uuid.uuid4()}.jpg', img)
        cls_token = get_cls_token(img64=img64, token_url=token_url)
        probs = get_probs(cls_token, label_url=label_url)
        if len(probs) > 4 and probs[4] > 0.95:
            found['摩托车'] = True
            return found

    return found

# 多标签模型过滤
async def person_label_handler(*args, **kwargs):
    name = kwargs.get('name')
    result = kwargs.get('result')
    if result is None:
        logger.warning('result is None')
        return {'行人':False, '施工人员':False}
    frame = kwargs.get('frame')
    if frame is None:
        logger.warning('frame is None')
        return {'行人':False, '施工人员':False}

    # 获取env来获取配置的URL
    env = kwargs.get('env')
    token_url = env.get_token_url() if env else None
    label_url = env.get_label_url() if env else None

    found = {'行人':False, '施工人员':False}
    for person in result.GetObjects('person'):
        img64 = frame.crop64(person.rectangle(),extend=0.2)
        cls_token = get_cls_token(img64=img64, token_url=token_url)
        probs = get_probs(cls_token, label_url=label_url)
        # print(name, probs)
        if probs[0] > 0.95 and probs[0] > probs[1]:
            found['行人'] = True
        if probs[1] > 0.95 and probs[1] > probs[0]:
            found['施工人员'] = True
        if found['行人'] and found['施工人员']:
            return found

    return found

# 浓烟事件处理
async def smoke_handler(*args, **kwargs):
    name = kwargs.get('name')
    result = kwargs.get('result')
    if result is None:
        return
    frame = kwargs.get('frame')
    if frame is None:
        return

    smoke_objects = result.GetObjects('smoke')
    if not smoke_objects:
        return

    all_xmin, all_ymin = float('inf'), float('inf')
    all_xmax, all_ymax = float('-inf'), float('-inf')
    for obj in smoke_objects:
        xmin, ymin, xmax, ymax = obj.rectangle()
        all_xmin = min(all_xmin, xmin)
        all_ymin = min(all_ymin, ymin)
        all_xmax = max(all_xmax, xmax)
        all_ymax = max(all_ymax, ymax)

    center = [all_xmin + (all_xmax - all_xmin) / 2, all_ymin + (all_ymax - all_ymin) / 2]
    w, h = all_xmax - all_xmin, all_ymax - all_ymin
    target_ratio = 0.25
    expand_factor = 1.0 / target_ratio
    w_expanded = w * expand_factor
    h_expanded = h * expand_factor
    max_dim = max(w_expanded, h_expanded)
    w, h = max_dim, max_dim
    w, h = max(w, 0.15), max(h, 0.15)
    w, h = min(w, 1.0), min(h, 1.0)

    found = {'浓烟': False}
    sess = Session(version=version, port=port, prefix=prefix)
    v = await sess.Text('''
任务目标：请判断图片中是否有浓密的大面积烟雾。请排除云雾、水汽和正常天气现象。

输出格式：请输出分析过程，最后以 "浓烟: [是/否] conf:[置信度]" 的格式给出判断结果。
''', frame.crop64(center=center, dim=[w, h]))

    logger.info(f"浓烟检测: {name}:\n{v}")
    reward = Reward(v)
    if reward.yes():
        found['浓烟'] = True
    return found

# 火焰事件处理
async def flame_handler(*args, **kwargs):
    name = kwargs.get('name')
    result = kwargs.get('result')
    if result is None:
        return
    frame = kwargs.get('frame')
    if frame is None:
        return

    flame_objects = result.GetObjects('flame')
    if not flame_objects:
        return

    all_xmin, all_ymin = float('inf'), float('inf')
    all_xmax, all_ymax = float('-inf'), float('-inf')
    for obj in flame_objects:
        xmin, ymin, xmax, ymax = obj.rectangle()
        all_xmin = min(all_xmin, xmin)
        all_ymin = min(all_ymin, ymin)
        all_xmax = max(all_xmax, xmax)
        all_ymax = max(all_ymax, ymax)

    center = [all_xmin + (all_xmax - all_xmin) / 2, all_ymin + (all_ymax - all_ymin) / 2]
    w, h = all_xmax - all_xmin, all_ymax - all_ymin
    target_ratio = 0.25
    expand_factor = 1.0 / target_ratio
    max_dim = max(w * expand_factor, h * expand_factor)
    w, h = max_dim, max_dim
    w, h = max(w, 0.15), max(h, 0.15)
    w, h = min(w, 1.0), min(h, 1.0)

    found = {'火焰': False}
    sess = Session(version=version, port=port, prefix=prefix)
    v = await sess.Text('''
任务目标：请判断图片中是否有明显的火焰。请排除车辆刹车灯、反光和警示灯。

输出格式：请输出分析过程，最后以 "火焰: [是/否] conf:[置信度]" 的格式给出判断结果。
''', frame.crop64(center=center, dim=[w, h]))

    logger.info(f"火焰检测: {name}:\n{v}")
    reward = Reward(v)
    if reward.yes():
        found['火焰'] = True
    return found

