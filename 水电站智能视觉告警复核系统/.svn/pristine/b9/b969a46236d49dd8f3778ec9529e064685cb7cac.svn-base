# 行人事件处理
async def person_handler(*args, **kwargs):
    # output_dir = './output_person'
    # if not os.path.exists(output_dir):
    #     os.makedirs(output_dir)
    result = kwargs.get('result')
    if result is None:
        logger.warning('result is None')
        return {'行人':False, '施工人员':False}
    frame = kwargs.get('frame')
    if frame is None:
        logger.warning('frame is None')
        return {'行人':False, '施工人员':False}

    found = {'行人':False, '施工人员':False}
    for person in result.GetObjects('person'):
        # print(f"Object details - Label: {person.label()}, Center: {person.center()}, Rectangle: {person.rectangle()}")
        # print("person",person)
        sess = Session(version=version, port=port, prefix=prefix)
        # bbox = person.rectangle()
        # center = [bbox[0]+(bbox[2]-bbox[0])/2,bbox[1]+(bbox[3]-bbox[1])/2]
        # img64 = frame.crop64(person.rectangle(),extend=0.1,resize=(512,512))

        # img = frame.crop(person.rectangle(),extend=0.1)
        # cv2.imwrite(f'output_person2/{uuid.uuid4()}.jpg', img)
        # global k
        # k += 1
        # img = frame.crop(person.rectangle(),extend=0.1)
        # imgname = '%04d.jpg' % k
        # cv2.imwrite(f'output/{imgname}', img)
        # print('write jpg img')
        # while True:
        #     pass

        img64 = frame.crop64(person.rectangle(),extend=0.2,resize=(512,512))
        v = await sess.Text('描述一下图片中人物的上半身穿着', img64)
        logger.info(f"行人检测: {v}")
        if (('橙' in v or '黄' in v or '红' in v or '粉' in v or '绿' in v) and ('反光' in v or '背心' in v or '马甲' in v)) or ('消防服' in v) or ('制服' in v) or ('警服' in v) or ('头盔' in v) or ('安全帽' in v):
            found['施工人员'] = True
            # img = frame.crop(person.rectangle(),extend=0.1)
            # cv2.imwrite(f'output_person2/施工人员{v}{uuid.uuid4()}.jpg', img)
        else:
            found['行人'] = True
            # img = frame.crop(person.rectangle(),extend=0.1)
            # cv2.imwrite(f'output_person2/行人{v}{uuid.uuid4()}.jpg', img)
        
      

        if found['行人'] and found['施工人员']:
            return found

    return found

# 抛洒物事件处理
async def debris_handler(*args, **kwargs):
    name = kwargs.get('name')
    result = kwargs.get('result')
    if result is None:
        logger.warning('result is None')
        return
    frame = kwargs.get('frame')
    if frame is None:
        logger.warning('frame is None')
        return

    # 查找外切矩形
    debris_objects = result.GetObjects('debris')
    if not debris_objects:
        return
    
    # 收集所有识别框，计算最大边界
    all_xmin, all_ymin = float('inf'), float('inf')
    all_xmax, all_ymax = float('-inf'), float('-inf')
    
    for obj in debris_objects:
        xmin, ymin, xmax, ymax = obj.rectangle()
        all_xmin = min(all_xmin, xmin)
        all_ymin = min(all_ymin, ymin)
        all_xmax = max(all_xmax, xmax)
        all_ymax = max(all_ymax, ymax)
    
    # 计算所有框的外接矩形的中心和尺寸
    center = [all_xmin + (all_xmax - all_xmin) / 2, all_ymin + (all_ymax - all_ymin) / 2]
    w, h = all_xmax - all_xmin, all_ymax - all_ymin
    area = w * h
    print(f"合并后的区域面积: {area}")
    
    # 按比例扩展，使目标在裁剪图像中占合适比例（约25%）
    target_ratio = 0.25
    expand_factor = 1.0 / target_ratio  # 扩展因子为4.0
    
    # 计算扩展后的宽高
    w_expanded = w * expand_factor
    h_expanded = h * expand_factor
    
    # 保持宽高比，取较大值确保目标完整显示
    max_dim = max(w_expanded, h_expanded)
    w, h = max_dim, max_dim
    
    # 设置最小裁剪尺寸，避免裁剪区域过小
    w, h = max(w, 0.15), max(h, 0.15)
    # 设置最大裁剪尺寸，避免超出图像范围
    w, h = min(w, 1.0), min(h, 1.0)
    
    # 只调用一次大模型
    found = {
        '抛洒物': False,
    }
    
    sess = Session(version=version, port=port, prefix=prefix)
    v = await sess.Text('照片中有什么', frame.crop64(center=center, dim=[w, h]))
    
    cv2.imwrite(f'debug/{v}{uuid.uuid4()}.jpg', frame.crop(center=center, dim=[w, h]))
    logger.info(f"抛洒物检测: {name}:\n{v}")
    
    if '箱子' in v or '纸箱' in v or '盒子' in v or '垃圾' in v:
        found['抛洒物'] = True
        # cv2.imwrite(f'debug/抛撒物{uuid.uuid4()}.jpg', frame.crop(center=center, dim=[w, h]))
    
    return found

    # 以外切矩形的中心为中心，宽高至少因为原图宽高的1/2
    # w,h = x2-x1,y2-y1
    # center = x1+w/2,y1+h/2
