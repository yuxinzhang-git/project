def fire_detect(img64):
    resp = requests.post('http://192.168.1.65:7002/detect-info', json={"conf": 0.3, 'image':img64})
    # print(resp.text)
    return [e for e in resp.json()['results'] if e['class_name'] == 'Fire' or e['class_name'] == 'Smoke']

# 缺省处理
async def default_handler(*args, **kwargs):
    pass

# 烟火事件处理
async def fire_handler(*args, **kwargs):
    name = kwargs.get('name')
    result = kwargs.get('result')
    if result is None:
        logger.warning('result is None')
        return
    frame = kwargs.get('frame')
    if frame is None:
        logger.warning('frame is None')
        return

    # # 查找外切矩形
    # x1,y1,x2,y2 = 1.0,1.0,0.,0.
    # for obj in result.GetObjects('fire'):
    #     xmin,ymin,xmax,ymax = obj.rectangle()
    #     x1,y1,x2,y2 = min(xmin,x1),min(ymin,y1),max(xmax,x2),max(ymax,y2)

    # # 以外切矩形的中心为中心，宽高至少因为原图宽高的1/2
    # w,h = x2-x1,y2-y1
    # center = x1+w/2,y1+h/2
    # w,h = max(w,0.5),max(h,0.5)
    debris_objects = result.GetObjects('fire')
    if not debris_objects:
        return
    
    # 收集所有识别框，计算最大边界
    all_xmin, all_ymin = float('inf'), float('inf')
    all_xmax, all_ymax = float('-inf'), float('-inf')
    
    for obj in debris_objects:
        xmin, ymin, xmax, ymax = obj.rectangle()
        all_xmin = min(all_xmin, xmin)
        all_ymin = min(all_ymin, ymin)
        all_xmax = max(all_xmax, xmax)
        all_ymax = max(all_ymax, ymax)
    
    # 计算所有框的外接矩形的中心和尺寸
    center = [all_xmin + (all_xmax - all_xmin) / 2, all_ymin + (all_ymax - all_ymin) / 2]
    w, h = all_xmax - all_xmin, all_ymax - all_ymin
    area = w * h
    
    
    # 按比例扩展，使目标在裁剪图像中占合适比例（约25%）
    target_ratio = 0.25
    expand_factor = 1.0 / target_ratio  # 扩展因子为4.0
    
    # 计算扩展后的宽高
    w_expanded = w * expand_factor
    h_expanded = h * expand_factor
    
    # 保持宽高比，取较大值确保目标完整显示
    max_dim = max(w_expanded, h_expanded)
    w, h = max_dim, max_dim
    
    # 设置最小裁剪尺寸，避免裁剪区域过小
    w, h = max(w, 0.15), max(h, 0.15)
    # 设置最大裁剪尺寸，避免超出图像范围
    w, h = min(w, 1.0), min(h, 1.0)

    

    


    

    found = {
        '烟火': False,
        # '抛洒物': False,
    }
    
    sess = Session(version=version, server="127.0.0.1" ,port=port, prefix=prefix)
    v = await sess.Text('''
    任务目标：请判断图片中是否有火焰、烟雾或燃烧现象。请排除车辆本身的刹车灯和反光。

    输出格式：请输出你的分析逻辑,最后以 "火: [是/否] conf:[置信度]，烟雾: [是/否] conf:[置信度]，强光光源: [是/否] conf:[置信度]" 的格式给出判断结果。
    

    
    请根据你的观察，严格区分燃烧的火焰和警示用的强光。
        
    ''', frame.crop64(center=center,dim=[w,h]))
    # v = await sess.Text('请判断图片中是否有火焰、烟雾或燃烧现象。请排除车辆本身的刹车灯和反光', frame.crop64(center=center,dim=[w,h]))
    # v = await sess.Text('''
    # 任务目标：请判断图片中是否有火焰、烟雾或燃烧现象。请排除车辆本身的刹车灯和反光。

    # 输出格式：请直接以 "火: [是/否]，烟雾: [是/否]，强光光源: [是/否]" 的格式给出判断结果。
    

    # 关键区分标准：
    # 1. 火焰（Fire）：形状不规则，颜色高亮橙黄，边缘模糊，有热气腾腾/燃烧的动态视觉效果。
    # 2. 强光光源（Bright Light Source）：形状通常是规则的几何形状（圆形、矩形），边缘清晰，发光均匀且静态，通常来自车辆部件（如尾灯、工作灯）。

    # 请根据你的观察，严格区分燃烧的火焰和警示用的强光。
        
    # ''', frame.crop64(center=center,dim=[w,h]))
    # v = await sess.Text('请仔细判断图片中除了车辆尾灯之外，是否出现火焰、烟雾或燃烧现象。请排除车辆本身的刹车灯和反光', frame.crop64(center=center,dim=[w,h]))
    # cv2.imwrite(f'debug/{v}{uuid.uuid4()}.jpg', frame.crop(center=center,dim=[w,h]))

    # 保存图片和回答到markdown文件
    import os
    from datetime import datetime
    import base64

    debug_dir = 'debug'
    if not os.path.exists(debug_dir):
        os.makedirs(debug_dir)

    # 生成唯一的文件名
    timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
    unique_id = uuid.uuid4().hex[:8]
    image_filename = f"{debug_dir}/smoke_detect_{timestamp}_{unique_id}.jpg"
    markdown_filename = f"{debug_dir}/smoke_detection_results.md"

    # 保存图片文件
    cropped_img = frame.crop(center=center, dim=[w, h])
    cv2.imwrite(image_filename, cropped_img)

    

    # 写入或追加到markdown文件
    with open(markdown_filename, 'a', encoding='utf-8') as md_file:
            # md_file.write(f"\n## 烟火检测记录 - {timestamp}_{unique_id}\n\n")
            # md_file.write(f"### 检测时间\n{datetime.now().strftime('%Y-%m-%d %H:%M:%S')}\n\n")
            # md_file.write(f"### 检测对象\n{name}\n\n")
            md_file.write(f"### 发送的图片\n![检测图片](Y:/data3/xzsta/python/debug/smoke_detect_{timestamp}_{unique_id}.jpg)\n\n")
            # md_file.write(f"### 题词内容\n```\n任务目标：请你仔细分析图片，判断其中是否出现了火（火焰）或烟雾。同时，你需要区分火焰与车辆尾灯、工作灯、反光等强光光源。\n\n输出格式：请直接以 \"火: [是/否]，烟雾: [是/否]，强光光源: [是/否]\" 的格式给出判断结果。\n\n关键区分标准：\n1. 火焰（Fire）：形状不规则，颜色高亮橙黄，边缘模糊，有热气腾腾/燃烧的动态视觉效果。\n2. 强光光源（Bright Light Source）：形状通常是规则的几何形状（圆形、矩形），边缘清晰，发光均匀且静态，通常来自车辆部件（如尾灯、工作灯）。\n\n请根据你的观察，严格区分燃烧的火焰和警示用的强光。\n```\n\n")
            md_file.write(f"### 模型回答\n```\n{v}\n```\n\n")
            md_file.write("---\n\n")

    logger.info(f"烟火检测: {name}:\n{v}")
    logger.info(f"图片和回答已保存到: {image_filename} 和 {markdown_filename}")
    reward = Reward(v)
    if reward.yes():
        found['烟火'] = True
        # cv2.imwrite(f'debug/ture{uuid.uuid4()}.jpg', frame.crop(center=center,dim=[w,h]))
    else:
        found['烟火'] = False
        # cv2.imwrite(f'debug/false{v}{uuid.uuid4()}.jpg', frame.crop(center=center,dim=[w,h]))
    # if '浓烟' in v or '黑烟' in v or '火焰' in v or '火光' in v or '火堆' in v or '燃烧' in v or '火苗' in v or '烟雾' in v:
    #     found['烟火'] = True
    # if '无法' in v:
