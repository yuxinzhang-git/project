# 游泳事件处理
async def swimming_handler(*args, **kwargs):
    result = kwargs.get('result')
    if result is None:
        return {'游泳': False}
    frame = kwargs.get('frame')
    if frame is None:
        return {'游泳': False}

    found = {'游泳': False}
    for swimmer in result.GetObjects('swimming'):
        sess = Session(version=version, port=port, prefix=prefix)
        img64 = frame.crop64(swimmer.rectangle(), extend=0.2, resize=(512, 512))
        v = await sess.Text('请判断图片中的人是否在游泳或正在水中', img64)
        logger.info(f"游泳检测: {v}")
        if '游泳' in v or '水中' in v or '溺水' in v:
            found['游泳'] = True
            return found
    return found

# 人员闯入事件处理
async def intrusion_handler(*args, **kwargs):
    result = kwargs.get('result')
    if result is None:
        return {'人员闯入': False}
    frame = kwargs.get('frame')
    if frame is None:
        return {'人员闯入': False}

    found = {'人员闯入': False}
    for person in result.GetObjects('person'):
        sess = Session(version=version, port=port, prefix=prefix)
        img64 = frame.crop64(person.rectangle(), extend=0.2, resize=(512, 512))
        v = await sess.Text('描述图片中人物的位置和周围环境，判断此人是否在不应出现的危险或受限区域内', img64)
        logger.info(f"人员闯入检测: {v}")
        if '闯入' in v or '禁区' in v or '危险区域' in v or '受限' in v:
            found['人员闯入'] = True
            return found
    return found

