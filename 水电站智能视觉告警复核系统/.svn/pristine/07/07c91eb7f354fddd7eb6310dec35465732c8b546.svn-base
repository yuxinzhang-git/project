logger = logging.getLogger(__name__)
output_folder = "detected_images"
def get_image_dimensions_from_base64(base64_string):
   
        try:
            # 1. 解码 base64 字符串
            img_bytes = base64.b64decode(base64_string)

            # 2. 将字节数据转换为 NumPy 数组
            nparr = np.frombuffer(img_bytes, np.uint8)

            # 3. 使用 OpenCV 解码图像
            img = cv2.imdecode(nparr, cv2.IMREAD_COLOR)

            # 如果解码失败，img 将为 None
            if img is None:
                logger.error("错误：无法解码图像。")
                return None, None

            # 4. 获取图像的尺寸
            # img.shape 返回 (height, width, channels)
            height, width, _ = img.shape

            return width, height

        except Exception as e:
            logger.error(f"处理过程中发生错误: {e}")
            return None, None

class Scene:
    def __init__(self, detect_url='', track_url='',fire_url=''):
        """
        初始化场景，管理全局信息和分析。
       
        """
        
       
        self.detect_url = detect_url
        self.track_url = track_url
        self.fire_url = fire_url
        
        self.frame_width = 0
        self.frame_height = 0
        
        
        # 道路识别模块
        self.road_mask = None
        self.road_polygons = None # 存储传入的归一化多边形坐标 
        
        self.POSITION_TOLERANCE = 10                     # 停车检测的像素容差
        self.STATIONARY_THRESHOLD = 4                    # 停车检测的帧数阈值
        self._tracker=Tracker(track_url)
        
        # OSD 检测相关属性
        self.enable_osd_check = True  # 默认不启用 OSD 检测
        self.previous_osd_region = None  # 存储上一帧的 OSD 区域
        
        # 停车图像验证相关属性
        self.parking_similarity_threshold = 0.70  # 图像相似度阈值（使用OpenCV多种方法综合计算，0-1之间，越接近1越相似）

        # 拥堵检测相关属性
        # self.LOW_SPEED_THRESHOLD = 5  # 低速阈值，单位为像素/帧
        # self.MIN_CARS_FOR_CONGESTION = 4 # 触发拥堵检测的最小车辆数
        # self.MIN_TRAJECTORY_LENGTH = 3  # 计算速度所需的最小轨迹长度

        self.CONGESTION_THRESHOLD = 0.3  # 默认拥堵阈值 (可调整)
        self.MIN_CARS_FOR_CONGESTION = 4 # 触发拥堵检测的最小车辆数
        
        # 算法阈值配置
        self.fire_conf = 0.5          # 烟火检测阈值
        self.debris_conf = 0.7        # 抛洒物检测阈值
        self.person_conf = 0.5        # 行人检测阈值  
        self.average_speed = 10       # 平均速度阈值
        self.vehicle_count = 5        # 车辆数量阈值
        self.motorcycle_conf = 0.05   # 摩托车检测阈值
        self.slice_params = [2,2,0.2,0.2]  # 默认分片参数
        
        # 主方向配置（用于逆行检测）
        self.main_directions = []    # 从配置文件读取的主方向向量
        
    def set_main_direction(self, direction_config):
        if isinstance(direction_config, list):
                        self.main_directions = []
                        # 配置格式: [{"end": {"x": 0.404, "y": 0.192}, "start": {"x": 0.512, "y": 0.506}}, ...]
                        for idx, direction_item in enumerate(direction_config):
                            if 'start' in direction_item and 'end' in direction_item:
                                start = direction_item['start']
                                end = direction_item['end']
                                # 计算方向向量 (归一化坐标)
                                dx = end['x'] - start['x']
                                dy = end['y'] - start['y']
                                # 归一化方向向量
                                norm = np.sqrt(dx * dx + dy * dy)
                                if norm > 0:
                                    direction_vector = np.array([dx / norm, dy / norm])
                                    self.main_directions.append(direction_vector)
                                    logger.info(f"主方向[{idx}]已配置: start({start['x']:.3f}, {start['y']:.3f}) -> end({end['x']:.3f}, {end['y']:.3f})")
                                    logger.info(f"  归一化向量: {direction_vector}")
                                else:
                                    logger.warning(f"主方向[{idx}]起点和终点相同，跳过")
                                    self.main_directions.append(None)
                            else:
                                logger.warning(f"主方向[{idx}]配置缺少 start 或 end 字段，跳过")
                                self.main_directions.append(None)
                        logger.info(f"共配置 {len(self.main_directions)} 个主方向（对应 ROI 区域）")

    def set_osd_check(self, enabled=False):
        """
        设置是否启用 OSD 相似度检测
        
        Args:
            enabled (bool): 是否启用 OSD 检测，默认为 False
        """
        self.enable_osd_check = enabled
        if enabled:
            logger.info("OSD 相似度检测已启用")
        else:
            logger.info("OSD 相似度检测已禁用")
            # 重置 OSD 区域缓存
            self.previous_osd_region = None

    def configure_params(self, yolo_config):
        """
        配置YOLO检测参数
        
        Args:
            yolo_config (dict): 包含YOLO配置的字典
                - Slice: 分片参数，格式为"2,2,0.2,0.2"
                - FireConf: 烟火检测阈值
                - PersonConf: 行人检测阈值  
                - AverageSpeed: 平均速度阈值
                - VehicleCount: 车辆数量阈值
                - MotorcycleConf: 摩托车检测阈值
                - EnableOsdCheck: 是否启用 OSD 检测（可选）
        """
        try:
            # 处理分片参数 Slice
            if 'Slice' in yolo_config:
                slice_str = yolo_config['Slice']
                if isinstance(slice_str, str):
                    # 解析字符串格式的分片参数，如 "2,2,0.2,0.2"
                    slice_parts = slice_str.split(',')
                    if len(slice_parts) == 4:
                        self.slice_params = [float(part.strip()) for part in slice_parts]
                        # 前两个参数应该是整数（分片数）
                        self.slice_params[0] = int(self.slice_params[0])
                        self.slice_params[1] = int(self.slice_params[1])
                        logger.info(f"分片参数已更新: {self.slice_params}")
                    else:
                        logger.warning(f"分片参数格式错误，使用默认值: {self.slice_params}")
                elif isinstance(slice_str, list) and len(slice_str) == 4:
                    self.slice_params = slice_str
                    logger.info(f"分片参数已更新: {self.slice_params}")
            
            # 处理烟火检测阈值
            if 'FireConf' in yolo_config:
                try:
                    self.fire_conf = float(yolo_config['FireConf'])
                    logger.info(f"烟火检测阈值已更新: {self.fire_conf}")
                except (ValueError, TypeError):
                    logger.warning(f"烟火检测阈值格式错误，使用默认值: {self.fire_conf}")
            
            # 处理行人检测阈值
            if 'PersonConf' in yolo_config:
                try:
                    self.person_conf = float(yolo_config['PersonConf'])
                    logger.info(f"行人检测阈值已更新: {self.person_conf}")
                except (ValueError, TypeError):
                    logger.warning(f"行人检测阈值格式错误，使用默认值: {self.person_conf}")
            
            # 处理平均速度阈值
            if 'AverageSpeed' in yolo_config:
                try:
                    self.average_speed = float(yolo_config['AverageSpeed'])
                    logger.info(f"平均速度阈值已更新: {self.average_speed}")
                except (ValueError, TypeError):
                    logger.warning(f"平均速度阈值格式错误，使用默认值: {self.average_speed}")
            
            # 处理车辆数量阈值
            if 'VehicleCount' in yolo_config:
                try:
                    self.vehicle_count = int(yolo_config['VehicleCount'])
                    logger.info(f"车辆数量阈值已更新: {self.vehicle_count}")
                except (ValueError, TypeError):
                    logger.warning(f"车辆数量阈值格式错误，使用默认值: {self.vehicle_count}")
            
            # 处理摩托车检测阈值
            if 'MotorcycleConf' in yolo_config:
                try:
                    self.motorcycle_conf = float(yolo_config['MotorcycleConf'])
                    logger.info(f"摩托车检测阈值已更新: {self.motorcycle_conf}")
                except (ValueError, TypeError):
                    logger.warning(f"摩托车检测阈值格式错误，使用默认值: {self.motorcycle_conf}")
            
            # 处理主方向配置（数组，与 ROI 一一对应）
            if 'Direction' in yolo_config:
                try:
                    direction_config = yolo_config['Direction']
                    if isinstance(direction_config, list):
                        self.main_directions = []
                        # 配置格式: [{"end": {"x": 0.404, "y": 0.192}, "start": {"x": 0.512, "y": 0.506}}, ...]
                        for idx, direction_item in enumerate(direction_config):
                            if 'start' in direction_item and 'end' in direction_item:
                                start = direction_item['start']
                                end = direction_item['end']
                                # 计算方向向量 (归一化坐标)
                                dx = end['x'] - start['x']
                                dy = end['y'] - start['y']
                                # 归一化方向向量
                                norm = np.sqrt(dx * dx + dy * dy)
                                if norm > 0:
                                    direction_vector = np.array([dx / norm, dy / norm])
                                    self.main_directions.append(direction_vector)
                                    logger.info(f"主方向[{idx}]已配置: start({start['x']:.3f}, {start['y']:.3f}) -> end({end['x']:.3f}, {end['y']:.3f})")
                                    logger.info(f"  归一化向量: {direction_vector}")
                                else:
                                    logger.warning(f"主方向[{idx}]起点和终点相同，跳过")
                                    self.main_directions.append(None)
                            else:
                                logger.warning(f"主方向[{idx}]配置缺少 start 或 end 字段，跳过")
                                self.main_directions.append(None)
                        logger.info(f"共配置 {len(self.main_directions)} 个主方向（对应 ROI 区域）")
                    else:
                        logger.warning(f"主方向配置格式错误，应为列表")
                except Exception as e:
                    logger.warning(f"解析主方向配置时出错: {e}")
            
            # 处理 OSD 检测开关
            # if 'EnableOsdCheck' in yolo_config:
            #     try:
            #         enable_osd = bool(yolo_config['EnableOsdCheck'])
            #         self.set_osd_check(enable_osd)
            #     except (ValueError, TypeError):
            #         print(f"WARNING: OSD检测开关格式错误，使用默认值: {self.enable_osd_check}")
                    
        except Exception as e:
            logger.warning(f"配置参数时发生错误: {e}")
            logger.warning("将使用默认参数")

        # 初始化场景事件
        self.events = {
            # 目标检测
            '行人': False,
            '物体遗留': False,
            '摩托车': False,

            '烟火':False,
            # 目标跟踪
            '逆行': False,
            '停车': False,
            '行驶缓慢': False,
        }
    
    def set_road_mask(self, polygons, width, height):
        """
        根据传入的归一化多边形坐标生成道路掩码。

        Args:
            polygons (list): 包含多边形顶点的列表，如 [[{'x':0.1,'y':0.1}, ...]]。
            width (int): 图像宽度。
            height (int): 图像高度。
        """
        self.frame_width = width
        self.frame_height = height
        self.road_polygons = polygons
        self.road_mask = np.zeros((self.frame_height, self.frame_width), dtype=np.uint8)
        
        for poly in polygons:
            # 将归一化坐标转换为像素坐标
            points = np.array([
                (int(p['x'] * self.frame_width), int(p['y'] * self.frame_height))
                for p in poly
            ], dtype=np.int32)
            
            # 绘制实心多边形到掩码上
            cv2.fillPoly(self.road_mask, [points], 255)
        
        logger.info("道路掩码已根据传入的多边形设置。")
        
    
